{
  "name": "grok-hack",
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <27"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "check:server-types": "node scripts/check-server-type-baseline.mjs",
    "ci": "bash scripts/ci-local.sh full",
    "ci:quick": "bash scripts/ci-local.sh quick",
    "lint": "eslint . --max-warnings=0",
    "server": "tsx server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8080",
    "tunnel:prod": "cloudflared tunnel --config cloudflare/grokhack-tunnel.yml run 48eb2839-41c7-426b-9bed-8cce35b7b545",
    "prod": "bash scripts/grokhack-supervisor.sh",
    "prod:install": "bash scripts/install-service.sh install",
    "prod:uninstall": "bash scripts/install-service.sh uninstall",
    "prod:status": "bash scripts/install-service.sh status",
    "prod:reload": "bash scripts/deploy.sh soft",
    "prod:ensure": "bash scripts/deploy.sh ensure",
    "prod:logs": "tail -f data/logs/supervisor.log data/logs/server.log data/logs/tunnel.log",
    "discord:setup": "node scripts/discord-setup.mjs",
    "discord:invite": "open 'https://discord.com/api/oauth2/authorize?client_id=1524486455844536441&permissions=1099780198434&scope=bot%20applications.commands'",
    "qa:play": "node scripts/qa-play.mjs",
    "qa:chat": "node scripts/qa-chat-ui.mjs",
    "qa": "npm run qa:play && npm run qa:chat",
    "agent:bot": "node scripts/agent-bot.mjs",
    "agent:bot:local": "BOT_URL=ws://127.0.0.1:8080/ws node scripts/agent-bot.mjs",
    "agent:bot:careful": "BOT_STYLE=careful node scripts/agent-bot.mjs",
    "agent:ladder": "node scripts/bot-ladder.mjs",
    "agent:fleet": "bash scripts/bot-fleet-supervisor.sh start",
    "agent:fleet:status": "bash scripts/bot-fleet-supervisor.sh status",
    "agent:fleet:stop": "bash scripts/bot-fleet-supervisor.sh stop",
    "agent:fleet:restart": "bash scripts/bot-fleet-supervisor.sh restart",
    "agent:fleet:ensure": "bash scripts/bot-fleet-supervisor.sh ensure",
    "difficulty:report": "node scripts/difficulty-report.mjs",
    "audit:summary": "node scripts/audit-summary.mjs",
    "og": "node scripts/render-og.mjs",
    "og:death": "node scripts/render-death-card.mjs",
    "deploy:pages": "wrangler pages deploy public --project-name grokhack",
    "deploy": "bash scripts/deploy.sh full",
    "deploy:status": "bash scripts/deploy.sh status",
    "deploy:soft": "bash scripts/deploy.sh soft",
    "deploy:ensure": "bash scripts/deploy.sh ensure",
    "edge:types": "npm --prefix edge run types",
    "edge:check": "npm --prefix edge run check",
    "edge:test": "npm --prefix edge test",
    "edge:build": "npm --prefix edge run build:all",
    "edge:verify": "npm --prefix edge run verify",
    "shadow:catchup": "tsx scripts/shadow-catchup.ts",
    "preview": "vite preview",
    "test": "node scripts/run-tests-isolated.mjs",
    "test:coverage": "node scripts/run-tests-isolated.mjs --coverage",
    "test:property": "node scripts/run-tests-isolated.mjs src/shadow-journal.property.test.ts server/origin-journal.test.ts server/shadow-catchup.test.ts",
    "test:shadow-e2e": "tsx scripts/prove-shadow-catchup.ts",
    "test:fleet": "node scripts/run-tests-isolated.mjs scripts/fleet-manager.test.ts",
    "test:sim": "tsx scripts/test-and-simulate.mjs",
    "test:all": "npm test && tsx -e \"import { runBatchSimulation } from './src/test-harness.ts'; const r=runBatchSimulation(50); console.log('Sim wins:', r.filter(x=>x.outcome==='won').length+'/50');\"",
    "mcp:build": "npm --prefix mcp run build"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "discord.js": "^14.26.5",
    "irc-upd": "^0.11.0",
    "ws": "^8.18.0"
  },
  "overrides": {
    "undici": "6.27.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.7.0",
    "globals": "^17.7.0",
    "playwright": "^1.58.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
