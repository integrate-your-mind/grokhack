{
  "name": "grok-hack",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "server": "tsx server/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8080",
    "tunnel:prod": "cloudflared tunnel --config cloudflare/grokhack-tunnel.yml run 48eb2839-41c7-426b-9bed-8cce35b7b545",
    "prod": "bash scripts/run-prod.sh",
    "discord:setup": "node scripts/discord-setup.mjs",
    "qa:play": "node scripts/qa-play.mjs",
    "deploy:pages": "wrangler pages deploy public --project-name grokhack",
    "deploy": "bash scripts/deploy.sh",
    "preview": "vite preview",
    "test": "vitest run",
    "test:sim": "tsx scripts/test-and-simulate.mjs",
    "test:all": "vitest run && tsx -e \"import { runBatchSimulation } from './src/test-harness.ts'; const r=runBatchSimulation(50); console.log('Sim wins:', r.filter(x=>x.outcome==='won').length+'/50');\"",
    "mcp:build": "cd mcp && npm install && npm run build"
  },
  "dependencies": {
    "discord.js": "^14.26.4",
    "irc-upd": "^0.11.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
